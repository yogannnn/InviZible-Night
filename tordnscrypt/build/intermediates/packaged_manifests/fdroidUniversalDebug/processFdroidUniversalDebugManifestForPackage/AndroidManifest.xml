<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="pan.alexander.tordnscrypt.stable"
    android:installLocation="internalOnly"
    android:targetSandboxVersion="1"
    android:versionCode="27605"
    android:versionName="7.6.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="36" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" /> <!-- Allows an app to obtain the default gateway for ARP spoofing detection. -->
    <!-- https://developer.android.com/reference/android/net/wifi/WifiManager#getDhcpInfo() -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" /> <!-- Allows an app to use background networks for VPN connections. -->
    <!-- https://developer.android.com/develop/connectivity/network-ops/reading-network-state -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" /> <!-- Allows an app to access information about networks. -->
    <!-- https://developer.android.com/develop/connectivity/network-ops/managing -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Allows an app to open network sockets. -->
    <!-- https://developer.android.com/develop/connectivity/network-ops/managing -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" /> <!-- Allows an app to keep the CPU running to do work while the screen is off. -->
    <!-- https://developer.android.com/develop/background-work/background-tasks/scheduling/wakelock -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" /> <!-- Allows an app to provide access to resources on the local network. -->
    <!-- https://developer.android.com/privacy-and-security/local-network-permission -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />

    <permission
        android:name="pan.alexander.tordnscrypt.stable.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="pan.alexander.tordnscrypt.stable.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
